# Chave secreta para assinar os tokens JWT (gere uma string forte e aleatoria)
JWT_SECRET=your-random-jwt-secret-key-at-least-32-chars

# Chave para ofuscacao do token Discord no payload JWT
ENCRYPTION_KEY=your-custom-obfuscation-key-string

# URL(s) permitidas pelo CORS (separadas por virgula)
FRONTEND_URL=http://localhost:3000

# Porta do servidor
PORT=8080
